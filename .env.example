# WarpTorch Environment Configuration

# PyTorch Version: cpu or cuda (Docker only)
# Default: cpu (lightweight, ~200MB)
# Options: cpu, cuda, rocm
# Note: For local installation, see README.md for manual PyTorch installation
TORCH_VERSION=cpu

# Frontend port
FRONTEND_PORT=3001

# Backend port
BACKEND_PORT=8001

# CORS allowed origins
CORS_ORIGINS=http://localhost:3001,http://frontend:3001