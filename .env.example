# WarpTorch Environment Configuration

# PyTorch Version: cpu or cuda (Docker only)
# Default: cpu (lightweight, ~200MB)
# Options: cpu, cuda, rocm
# Note: For local installation, see README.md for manual PyTorch installation
TORCH_VERSION=cpu

# Frontend port
FRONTEND_PORT=3001
VITE_FRONTEND_PORT=${FRONTEND_PORT}

# Backend port
BACKEND_PORT=8001
VITE_BACKEND_PORT=${BACKEND_PORT}

# CORS allowed origins
CORS_ORIGINS=http://localhost:${FRONTEND_PORT},http://frontend:${FRONTEND_PORT}
